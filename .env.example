# ─── Pulso environment ───────────────────────────────────────────────
# Copy to .env.local and fill. The app runs on MockConnector with NO env set.
# Real backends activate when their vars are present.

# ─── Supabase (production backend + auth) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers (abstraction: at least one; falls back to mock) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which provider is primary: "anthropic" | "openai"
PULSO_AI_PROVIDER=anthropic
# Optional: override the Anthropic model (validated; falls back to default if
# missing/invalid). e.g. claude-3-5-sonnet, claude-sonnet-4-6
PULSO_ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: override the OpenAI model (e.g. gpt-4o, gpt-4o-mini)
PULSO_OPENAI_MODEL=gpt-4o

# ─── Social connectors (real, env-gated) ──
# Instagram (Meta Graph API) — requires Business/Creator account + Meta App Review.
# The LIVE path uses a long-lived access token. Set IG_USER_TOKEN to activate it;
# without it the connector falls back to mock. The OAuth vars below are reserved
# for the upcoming callback-based token exchange (not yet wired).
IG_USER_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Bluesky (open API, no review) — personal use via app password
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# ─── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
