# ─── Pulso environment ───────────────────────────────────────────────
# Copy to .env.local and fill. The app runs on MockConnector with NO env set.
# Real backends activate when their vars are present.

# ─── Supabase (production backend + auth) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers (abstraction: at least one; falls back to mock) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which provider is primary: "anthropic" | "openai"
PULSO_AI_PROVIDER=anthropic

# ─── Social connectors (real, env-gated) ──
# Instagram (Meta Graph API) — requires Business/Creator account + Meta App Review
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Bluesky (open API, no review) — personal use via app password
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# ─── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
